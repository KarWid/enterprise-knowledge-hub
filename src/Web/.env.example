# Microsoft Entra External ID (CIAM) — frontend configuration
# Copy this file to .env.local and fill in your tenant values.

# Client ID of the SPA app registration in Entra External ID
VITE_ENTRA_CLIENT_ID=

# Full authority URL: https://<tenant-name>.ciamlogin.com/<tenant-id>
VITE_ENTRA_AUTHORITY=

# Hostname of the issuer (used in knownAuthorities): <tenant-name>.ciamlogin.com
VITE_ENTRA_ISSUER_HOST=

# Redirect URI registered in the SPA app registration
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# Client ID of the API app registration in Entra External ID
# This is sent as the scope when acquiring a token for the backend.
VITE_ENTRA_API_CLIENT_ID=
