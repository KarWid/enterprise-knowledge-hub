# Copy this file to .env.local and fill in the values for your Entra app registration.
# .env.local is gitignored by Vite and will not be committed.

# Client ID of the SPA app registration in Entra / Entra External ID
VITE_ENTRA_CLIENT_ID=

# Authority URL — for Entra: https://login.microsoftonline.com/<tenantId>
#                for Entra External ID (CIAM): https://<tenant>.ciamlogin.com/<tenantId>
VITE_ENTRA_AUTHORITY=

# Full scope URI exposed by the API app registration, e.g. api://<api-client-id>/access_as_user
VITE_API_SCOPE=
